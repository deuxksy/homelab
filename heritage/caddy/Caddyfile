# Caddyfile for Heritage Collection
# Tailscale Web Proxy & Reverse Proxy

:9080 {
    # Jellyfin
    redir /jellyfin /jellyfin/
    handle /jellyfin/* {
        reverse_proxy localhost:8096
    }

    # Transmission
    handle /transmission* {
        reverse_proxy localhost:8091
    }

    # Homepage (catch-all)
    handle {
        reverse_proxy localhost:3000
    }
}
